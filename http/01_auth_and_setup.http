### ========== 도메인 목록 조회 (인증 불필요) ==========
GET {{host}}/api/v1/domains
Content-Type: application/json

### ========== 1. 기안자 회원가입 ==========
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "name": "기안자테스트",
  "email": "drafter@test.com",
  "password": "Password123!",
  "passwordConfirm": "Password123!",
  "terms": {
    "privacyPolicyAgreed": true,
    "serviceTermsAgreed": true,
    "marketingAgreed": false
  }
}

### ========== 2. 결재자 회원가입 ==========
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "name": "결재자테스트",
  "email": "approver@test.com",
  "password": "Password123!",
  "passwordConfirm": "Password123!",
  "terms": {
    "privacyPolicyAgreed": true,
    "serviceTermsAgreed": true,
    "marketingAgreed": false
  }
}

### ========== 3. 수신자 회원가입 ==========
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "name": "수신자테스트",
  "email": "reviewer@test.com",
  "password": "Password123!",
  "passwordConfirm": "Password123!",
  "terms": {
    "privacyPolicyAgreed": true,
    "serviceTermsAgreed": true,
    "marketingAgreed": false
  }
}

### ========== 4. 기안자 로그인 ==========
### 응답의 data.accessToken 값을 위의 @drafterToken에 붙여넣기
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "drafter@test.com",
  "password": "Password123!"
}

### ========== 5. 결재자 로그인 ==========
### 응답의 data.accessToken 값을 위의 @approverToken에 붙여넣기
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "approver@test.com",
  "password": "Password123!"
}

### ========== 6. 수신자 로그인 ==========
### 응답의 data.accessToken 값을 위의 @reviewerToken에 붙여넣기
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "reviewer@test.com",
  "password": "Password123!"
}

### ========== 7. 내 정보 조회 (기안자) ==========
GET {{host}}/api/v1/auth/me
Authorization: Bearer {{drafterToken}}
Content-Type: application/json

### ========== 8. 이메일 중복 확인 ==========
POST {{host}}/api/v1/auth/check-email
Content-Type: application/json

{
  "email": "newuser@test.com"
}
